# Webflow Data Client (OAuth)
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=https://YOUR_VERCEL_APP/api/oauth/callback

# Optional CLI ingest (skip if using /app only)
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=

# OpenAI — text-embedding-3-small (ingest + query)
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role — server only, never in Webflow or the browser
SUPABASE_SERVICE_KEY=

# AES-256-GCM key for Webflow OAuth tokens at rest (32 random bytes, base64 or 64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Google sign-in (Google Cloud → Google Auth Platform → Clients → Web application).
# Redirect URI in Google: https://www.talaash.org/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Cron auth for /api/cron/purge (any long random string)
CRON_SECRET=

# Paddle checkout on /pricing (Paddle → Developer tools → Authentication → client-side token).
# Sandbox (sandbox-vendors.paddle.com) and live (vendors.paddle.com) have separate tokens and price IDs.
# Use sandbox values in .env.local and Vercel Preview; only live values in Vercel Production.
# Public by design; never put the Paddle API key here. Leave empty to show "Contact us to subscribe".
# Changing these requires a redeploy (they are inlined at build time).
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Price IDs (pri_…) from Paddle → Catalog → Products
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_EXTRA_COLLECTION_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_EXTRA_COLLECTION_YEARLY=
# Server-only. API key needs read/write on subscriptions and customer portal sessions.
PADDLE_API_KEY=
# From Paddle → Developer tools → Notifications → your destination (endpoint secret key).
# Webhook URL: https://www.talaash.org/api/paddle/webhook (www — apex redirects and breaks signatures).
PADDLE_WEBHOOK_SECRET=
