# Hosted Webflow App (OAuth) — you run this server; clients only click Connect
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
# Must match the app redirect URL, e.g. https://YOUR_VERCEL_APP/api/oauth/callback
WEBFLOW_REDIRECT_URI=

# Optional CLI-only token if you are not using the OAuth app
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=

# OpenAI — used for text-embedding-3-small (ingest + query embed)
OPENAI_API_KEY=

# Supabase project (Postgres + pgvector)
SUPABASE_URL=

# Service role key — server-side only (ingest worker and /search API).
# Never ship this to the browser. The frontend calls only the public /search URL.
SUPABASE_SERVICE_KEY=

# OpenAI — used for text-embedding-3-small (ingest + query embed)
OPENAI_API_KEY=

# Supabase project (Postgres + pgvector)
SUPABASE_URL=

# Service role key — server-side only (ingest worker and /search API).
# Never ship this to the browser. The frontend calls only the public /search URL.
SUPABASE_SERVICE_KEY=
