# Webflow Data Client (OAuth)
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=https://YOUR_VERCEL_APP/api/oauth/callback

# Optional CLI ingest (skip if using /app only)
WEBFLOW_TOKEN=
WEBFLOW_SITE_ID=

# OpenAI — text-embedding-3-small (ingest + query)
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role — server only, never in Webflow or the browser
SUPABASE_SERVICE_KEY=

# AES-256-GCM key for Webflow OAuth tokens at rest (32 random bytes, base64 or 64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Vercel Cron auth for /api/cron/purge (any long random string)
CRON_SECRET=
